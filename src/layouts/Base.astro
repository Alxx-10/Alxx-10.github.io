---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import photo from '../assets/images/photo.png';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description?: string;
}
const { title, description = profile.intro } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL((await getImage({ src: photo, width: 600, format: 'jpg' })).src, Astro.site);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pages = [
  ['/', 'Accueil'],
  ['/parcours', 'Parcours'],
  ['/projets', 'Projets'],
  ['/stages', 'Stages'],
  ['/veille', 'Veille & certifs'],
  ['/contact', 'Contact'],
] as const;
const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
const CV = `${base}/cv-alexis-leclerc.pdf`;
const LI = profile.linkedin;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#3b5bfd" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body>
    <div class="bg" aria-hidden="true"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>
    <nav>
      <div class="wrap">
        <a class="logo" href={`${base}/`}><span class="mono">AL</span>Alexis Leclerc</a>
        <button class="iconbtn" id="menu" aria-label="Menu" aria-expanded="false">☰</button>
        <div class="links" id="links">
          {pages.map(([href, label]) => (
            <a href={`${base}${href}`} class:list={{ on: isActive(href) }} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
          ))}
        </div>
        <button class="iconbtn" id="theme" aria-label="Changer de thème">◐</button>
      </div>
    </nav>
    <main><slot /></main>
    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} Alexis Leclerc — Réseaux, systèmes & cybersécurité</span>
        <span><a href={LI} target="_blank" rel="noopener">LinkedIn</a> · <a href="mailto:leclercalexis@icloud.com">Email</a> · <a href={CV} target="_blank" rel="noopener">CV</a></span>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const menu = document.getElementById('menu')!;
      const links = document.getElementById('links')!;
      menu.addEventListener('click', () => {
        const open = links.classList.toggle('open');
        menu.setAttribute('aria-expanded', String(open));
      });
      document.getElementById('theme')!.addEventListener('click', () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
      const reveal = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver((entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }), { threshold: 0.08 });
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
