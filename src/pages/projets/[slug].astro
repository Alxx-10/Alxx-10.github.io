---
import { getCollection } from 'astro:content';
import Fiche from '../../components/Fiche.astro';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Fiche entry={entry} backHref={`${base}/projets`} backLabel="Tous les projets" />
